{
  "name": "@crimaniak/vue-image-viewer",
  "version": "0.1.0",
  "description": "Vue 3 image viewer component: fit, cursor-anchored zoom, free pan, keyboard and toolbar controls.",
  "keywords": [
    "vue",
    "vue3",
    "image",
    "viewer",
    "zoom",
    "pan",
    "component"
  ],
  "license": "MIT",
  "author": "Alexey Kulentsov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crimaniak/vue-image-viewer.git"
  },
  "homepage": "https://github.com/crimaniak/vue-image-viewer#readme",
  "bugs": {
    "url": "https://github.com/crimaniak/vue-image-viewer/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-image-viewer.umd.cjs",
  "module": "./dist/vue-image-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-image-viewer.js",
      "require": "./dist/vue-image-viewer.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
